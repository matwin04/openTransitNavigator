            "name": "trip_id",
            "in": "query",
            "description": "Filter by a specific trip",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A JSON array of stop times",
            "content": {
              "application/json": {
