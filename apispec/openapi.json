      "get": {
        "summary": "Get stop times (departures)",
        "description": "Returns a list of stop times filtered by stop_id, trip_id, or both.",
        "parameters": [
          {
            "name": "stop_id",
            "in": "query",
            "description": "Filter by a specific stop",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
